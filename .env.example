# AntiDeepfake AI — example environment configuration.
# Copy to .env and adjust. All values are optional; sensible defaults apply.

# --- Auth ---
ADF_JWT_SECRET=change-me-in-production
ADF_JWT_EXPIRE_MINUTES=10080

# --- API / browser security ---
# Use "*" for local demos only. Production example:
# ADF_CORS_ORIGINS=https://antideepfakeai.com,https://www.antideepfakeai.com
ADF_CORS_ORIGINS=*

# --- Database / queue (docker-compose sets these automatically) ---
# DATABASE_URL=postgresql+psycopg2://antideepfake:antideepfake@db:5432/antideepfake
# REDIS_URL=redis://redis:6379/0

# --- Uploads ---
ADF_MAX_UPLOAD_MB=100
ADF_TRIAL_FREE_SCANS_PER_IP=1

# --- Video processing ---
ADF_FRAME_SAMPLE_RATE=10
ADF_VIDEO_MAX_FRAMES=60

# --- Models ---
# ADF_MODEL_DIR=backend/weights
# Set to 1 to require real pretrained weights (no heuristic fallback).
ADF_STRICT_MODELS=0
ADF_DEVICE=cpu

# --- Optional paid 3rd-party APIs (disabled unless set) ---
# ADF_ENABLE_PAID_APIS=0
# ADF_PREMIUM_DETECTORS=[{"name":"provider","url":"https://provider.example/api/detect","api_key_env":"PROVIDER_API_KEY"}]
# PROVIDER_API_KEY=

# --- Pretrained weight URLs for scripts/download_models.py (optional) ---
# ADF_FACE_WEIGHTS_URL=
# ADF_GAN_WEIGHTS_URL=
